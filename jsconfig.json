{
  "compilerOptions": {
    "target": "es2017",
    "allowSyntheticDefaultImports": false,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": "./",
    "paths": {
      "@components/*": ["app/components/*"],
      "@style-components/*": ["app/components/Elements/StyleComponents/*"],
      "@elements/*": ["app/components/Elements/*"],
      "@complex-elements/*": ["app/components/ComplexElements/*"],
      "@containers/*": ["app/containers/*"],
      "@common-pages/*": ["app/containers/CommonPages/*"],
      "@private-pages/*": ["app/containers/PrivatePages/*"],
      "@public-pages/*": ["app/containers/PublicPages/*"],
      "@utils/*": ["app/utils/*"],
      "@store/*": ["app/store/*"],
      "@configs/*": ["app/configs/*"],
      "@services/*": ["app/services/*"],
      "*": ["app/*"]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "docs",
    "server",
    "internals",
    "assets"
  ]
}
